<section class="max-w-xl mx-auto text-center py-12">
  <div class="text-6xl mb-4">✓</div>
  <h1 class="text-3xl font-bold">Got it. Thanks.</h1>
  <p class="mt-3 text-gorilla-muted">
    Your submission is in. Someone from our team will be in touch shortly.
  </p>
  <% if (typeof reference !== 'undefined' && reference) { %>
    <p class="mt-6 text-xs text-gorilla-muted">Reference: <code class="text-gorilla-accent"><%= reference %></code></p>
  <% } %>
  <div class="mt-8">
    <a href="/" class="btn btn-primary">Back to home</a>
  </div>
</section>
