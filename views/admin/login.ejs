<section class="max-w-sm mx-auto mt-16">
  <h1 class="text-2xl font-bold text-center mb-6">Broker Login</h1>
  <div class="bg-gorilla-panel border border-gorilla-border rounded-xl p-6">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 text-sm text-gorilla-danger bg-gorilla-dangerBg border border-gorilla-danger rounded px-3 py-2">
        <%= error %>
      </div>
    <% } %>
    <form action="/admin/login" method="POST" class="space-y-4">
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" name="password" id="password" autofocus required />
      </div>
      <button type="submit" class="btn btn-primary w-full">Sign in</button>
    </form>
  </div>
</section>
