<section>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-3xl font-bold">Agents</h1>
      <p class="text-gorilla-muted text-sm">Round-robin pool — next up is whoever has the oldest assignment.</p>
    </div>
    <div class="flex gap-2">
      <a href="/admin" class="btn btn-secondary">← Dashboard</a>
    </div>
  </div>

  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="mb-4 bg-gorilla-panel border border-gorilla-accent rounded px-4 py-2 text-sm text-gorilla-accent"><%= flash %></div>
  <% } %>

  <section class="bg-gorilla-panel border border-gorilla-border rounded-xl p-6 mb-8">
    <h2 class="text-lg font-semibold text-gorilla-accent mb-4">Add Agent</h2>
    <form action="/admin/agents" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-3">
      <div>
        <label for="full_name">Full Name *</label>
        <input type="text" name="full_name" id="full_name" required />
      </div>
      <div>
        <label for="email">Email *</label>
        <input type="email" name="email" id="email" required />
      </div>
      <div>
        <label for="phone">Phone</label>
        <input type="tel" name="phone" id="phone" />
      </div>
      <div class="flex items-end">
        <button type="submit" class="btn btn-primary w-full">Add Agent</button>
      </div>
    </form>
  </section>

  <% if (!agents || agents.length === 0) { %>
    <div class="bg-gorilla-panel border border-gorilla-border rounded-xl p-10 text-center text-gorilla-muted">
      No agents yet. Add one above to start round-robin assignment.
    </div>
  <% } else { %>
    <div class="space-y-3">
      <% agents.forEach((a, i) => { %>
        <div class="bg-gorilla-panel border border-gorilla-border rounded-lg p-5">
          <div class="flex items-start justify-between flex-wrap gap-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-lg"><%= a.full_name %></span>
                <span class="text-xs px-2 py-0.5 rounded <%= a.active ? 'bg-emerald-900 text-emerald-200' : 'bg-gorilla-border text-gorilla-muted' %>">
                  <%= a.active ? 'active' : 'inactive' %>
                </span>
                <% if (a.is_next_up) { %>
                  <span class="text-xs px-2 py-0.5 rounded bg-gorilla-accent text-gorilla-bg font-bold">NEXT UP</span>
                <% } %>
              </div>
              <div class="text-sm text-gorilla-muted mt-1"><%= a.email %><% if (a.phone) { %> &middot; <%= a.phone %><% } %></div>
              <div class="text-xs text-gorilla-muted mt-1">
                Last assigned: <%= a.last_assigned_at || 'never' %>
              </div>
            </div>

            <div class="flex gap-2 flex-wrap">
              <form action="/admin/agents/<%= a.id %>/toggle" method="POST">
                <button type="submit" class="btn btn-secondary"><%= a.active ? 'Deactivate' : 'Activate' %></button>
              </form>
              <form action="/admin/agents/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Delete <%= a.full_name %>?');">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            </div>
          </div>

          <details class="mt-3">
            <summary class="text-sm text-gorilla-muted cursor-pointer hover:text-gorilla-accent">Edit</summary>
            <form action="/admin/agents/<%= a.id %>" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-3 mt-3">
              <div>
                <label>Full Name</label>
                <input type="text" name="full_name" value="<%= a.full_name %>" required />
              </div>
              <div>
                <label>Email</label>
                <input type="email" name="email" value="<%= a.email %>" required />
              </div>
              <div>
                <label>Phone</label>
                <input type="tel" name="phone" value="<%= a.phone || '' %>" />
              </div>
              <div class="flex items-end">
                <button type="submit" class="btn btn-secondary w-full">Save</button>
              </div>
            </form>
          </details>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>
