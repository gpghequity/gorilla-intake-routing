<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Gorilla Realty' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            gorilla: {
              bg:      '#0b0d0f',
              panel:   '#15181c',
              border:  '#23272e',
              accent:  '#c9a227',
              accent2: '#e0b731',
              text:    '#f2f2f2',
              muted:   '#9aa1a9',
              danger:  '#b91c1c',
              dangerBg:'#2a0b0b'
            }
          }
        }
      }
    };
  </script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, sans-serif; }
    input[type="text"], input[type="email"], input[type="tel"], input[type="number"], input[type="url"], input[type="password"], select, textarea {
      background-color: #0f1215;
      border: 1px solid #2a2e35;
      color: #f2f2f2;
      border-radius: 0.375rem;
      padding: 0.5rem 0.75rem;
      width: 100%;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #c9a227;
      box-shadow: 0 0 0 2px rgba(201,162,39,0.25);
    }
    label { color: #d6d8db; font-size: 0.9rem; font-weight: 500; }
    .form-group { margin-bottom: 1rem; }
    .btn {
      display: inline-block; padding: 0.6rem 1.2rem; border-radius: 0.375rem;
      font-weight: 600; cursor: pointer; border: 1px solid transparent;
    }
    .btn-primary { background: #c9a227; color: #0b0d0f; }
    .btn-primary:hover { background: #e0b731; }
    .btn-secondary { background: transparent; color: #f2f2f2; border-color: #3a3f47; }
    .btn-secondary:hover { border-color: #c9a227; color: #c9a227; }
    .btn-danger { background: #b91c1c; color: #f2f2f2; }
  </style>
</head>
<body class="bg-gorilla-bg text-gorilla-text min-h-screen">
  <header class="border-b border-gorilla-border">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-gorilla-accent flex items-center justify-center text-gorilla-bg font-black text-xl">G</div>
        <div>
          <div class="text-lg font-bold leading-tight">GORILLA REALTY</div>
          <div class="text-xs text-gorilla-muted leading-tight">Good People. Good Homes.</div>
        </div>
      </a>
      <nav class="text-sm text-gorilla-muted flex gap-5">
        <a href="/buyer" class="hover:text-gorilla-accent">Buyers</a>
        <a href="/seller" class="hover:text-gorilla-accent">Have a Deal</a>
        <a href="/join" class="hover:text-gorilla-accent">Join Us</a>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-10">
    <%- include(page, typeof locals === 'object' ? locals : {}) %>
  </main>

  <footer class="border-t border-gorilla-border mt-16">
    <div class="max-w-6xl mx-auto px-6 py-6 text-xs text-gorilla-muted flex justify-between">
      <div>&copy; <%= new Date().getFullYear() %> Gorilla Realty / Good People Good Homes LLC</div>
      <div>Licensed in Pennsylvania</div>
    </div>
  </footer>
</body>
</html>
