# Copy this file to .env and fill in values for local dev.
# On Railway these go in the project's environment variables.

# Postgres URL (production only). Leave blank locally — app falls back to SQLite at db/gorilla.db.
DATABASE_URL=

# Admin dashboard password (required). Steve sets this.
ADMIN_PASSWORD=change-me

# Session secret (any long random string).
SESSION_SECRET=change-me-to-a-long-random-string

# SMTP (SendGrid). Leave blank to log emails to console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@gorillarealty.com

# Notification routing
NOTIFY_STEVE_EMAILS=paragonenterprisesllc@protonmail.com,steve@goodpeoplegoodhomes.com
NOTIFY_RYAN_EMAIL=huntingforhomesllc@gmail.com
NOTIFY_STORAGE_EMAIL=info@storageguys.net

# App
PORT=3001
APP_BASE_URL=http://localhost:3001
